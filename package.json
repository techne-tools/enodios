{
  "name": "enodios",
  "version": "1.2.0",
  "description": "An Obsidian plugin for Enodios, integrating the Hermes autonomous AI agent into your vault.",
  "keywords": [],
  "license": "MIT",
  "author": "prismatic7",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "obsidian-dev-utils build",
    "build:clean": "obsidian-dev-utils build:clean",
    "build:compile": "obsidian-dev-utils build:compile",
    "build:compile:svelte": "obsidian-dev-utils build:compile:svelte",
    "build:compile:typescript": "obsidian-dev-utils build:compile:typescript",
    "deploy": "cp dist/build/main.js dist/build/styles.css manifest.json \"${PLUGIN_DIR:?Set PLUGIN_DIR to your vault plugins folder}\"",
    "dev": "obsidian-dev-utils dev",
    "format": "obsidian-dev-utils format",
    "format:check": "obsidian-dev-utils format:check",
    "lint": "obsidian-dev-utils lint",
    "lint:md:fix": "obsidian-dev-utils lint:md:fix",
    "spellcheck": "obsidian-dev-utils spellcheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test:watch": "vitest",
    "version": "obsidian-dev-utils version"
  },
  "devDependencies": {
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@testing-library/react": "^16.3.3",
    "@tsconfig/strictest": "latest",
    "@types/luxon": "3.7.6",
    "@types/node": "^26.6.6",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "cspell": "^10.5.1",
    "date-fns": "4.4.0",
    "dprint": "^0.64.3",
    "eslint": "^10.15.0",
    "jiti": "2.7.0",
    "jsdom": "^31.0.1",
    "luxon": "3.7.2",
    "obsidian": "1.14.4",
    "obsidian-dev-skills": "^1.2.4",
    "obsidian-dev-utils": "^107.5.1",
    "obsidian-typings": "^6.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svelte": "^5.57.3",
    "type-fest": "^5.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@antfu/utils": "9.2.0",
    "boolean": "npm:dry-uninstall",
    "brace-expansion": "^5.0.3",
    "fast-uri": "^3.0.6",
    "postcss": "^8.5.25"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.21.1",
    "markdownlint-cli2": "^0.22.1",
    "prismjs": "^1.30.0"
  }
}
